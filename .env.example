NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API の認証。
# ローカル開発では API キーを使う(.env.local に設定)。
ANTHROPIC_API_KEY=
# 本番(Vercel)では API キーを置かず、Workload Identity Federation を使う。
# Vercel の Production 環境にだけ、下の ID を設定する(ID は秘密ではない)。
# 両方が設定されていると API キーより優先される。
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
