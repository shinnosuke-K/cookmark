# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# serwist (generated service worker; rebuilt by `next build`)
/public/sw.js
/public/sw.js.map

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# superpowers / sdd working files (not part of the shipped app)
.superpowers/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design handoff (do not commit)
/docs/design_handoff_cookmark_ui/
